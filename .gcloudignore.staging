# Upload manifest for manual `gcloud builds submit --config=cloudbuild.staging.yaml`.
#
# Identical to .gcloudignore except that Backend/ is NOT excluded.
# .gcloudignore excludes both `.git` and `Backend/`, so a tarball submit
# carries neither the submodule contents nor the git metadata needed to
# fetch them — the Flask build then dies at `COPY pyproject.toml uv.lock ./`
# with 'stat uv.lock: file does not exist' (builds 0628cc07 / 64116d9f,
# 2026-08-24). Keeping Backend/ is cheaper than shipping .git.
#
# Usage:
#   gcloud builds submit --config=cloudbuild.staging.yaml \
#     --ignore-file=.gcloudignore.staging --project=gen-lang-client-0491022701

.git
.gitignore
node_modules/
dist/
build/
coverage/
.angular/
.agent-work/
.terraform/
*.tfstate
*.tfstate.*
.env
.env.local
.env.*.local
.envrc

# Submodules and non-frontend code
# Backend/  <- deliberately NOT excluded here; see header
backend/
alirez-claude-skills/
gemstack/

# Python tooling (not used by the Express image)
.venv
.venv_sync
uv.lock

# CI/CD, agent, and tooling config
.github/
.claude/
.codex/
.gemini/
.junie/
.clawhub/
.aiignore
pyproject.toml
qodana-global-configurations.yaml
qodana.yaml
mkdocs.yml
setup_mcp_secrets.sh

